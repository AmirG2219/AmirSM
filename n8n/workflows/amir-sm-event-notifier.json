{
  "name": "Amir SM — render notifier",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "amir-sm-events",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "name": "Amir SM event",
      "webhookId": "amir-sm-events-0001",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "Amir SM webhook secret (header x-amirsm-secret = N8N_WEBHOOK_SECRET)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "version.ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "version.failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        240,
        0
      ],
      "name": "Ready or failed?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'Amir SM <REPLACE_WITH_VERIFIED_SENDER@yourdomain.com>', to: ['REPLACE_WITH_YOUR_ADDRESS@example.com'], subject: $json.body.event === 'version.ready' ? `Amir SM: draft v${$json.body.data.number} of “${$json.body.data.title}” is ready to review` : `Amir SM: draft v${$json.body.data.number} of “${$json.body.data.title}” failed`, text: $json.body.event === 'version.ready' ? 'Open Amir SM > Social Studio to watch the draft, review the caption, and approve or request changes.' : `The render failed: ${$json.body.data.error || 'see Amir SM for details'}. You can retry from the project page.` }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
        -80
      ],
      "name": "Email me (Resend)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE",
          "name": "Resend API key (Authorization: Bearer re_...)"
        }
      }
    }
  ],
  "connections": {
    "Amir SM event": {
      "main": [
        [
          {
            "node": "Ready or failed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ready or failed?": {
      "main": [
        [
          {
            "node": "Email me (Resend)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "meta": {
    "description": "Receives signed-by-secret events from the Amir SM app and emails you when a draft is ready or failed. Replace the sender/recipient placeholders and select credentials after import. Inactive by default."
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
