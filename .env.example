# Amir SM — environment template. Copy to .env (never commit .env).

# --- Server ---
HOST=127.0.0.1
PORT=4300
# Where the database, uploads, renders and exports live. Use a local, non-synced folder.
# (OneDrive/Dropbox syncing a live SQLite file and large videos is risky.)
DATA_DIR=./data
MAX_UPLOAD_MB=2048

# --- Anthropic (optional until you want AI planning/captions/email/research) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Hard usage guards (calls and tokens per UTC day). The app refuses AI calls beyond these.
AI_DAILY_CALL_LIMIT=60
AI_DAILY_TOKEN_LIMIT=400000
# Opt-in: let the Market Researcher use Anthropic's server-side web search tool (billed per search).
AI_WEB_SEARCH_ENABLED=false

# --- Email ---
# fixture = local sample mailbox (default, clearly labelled in the UI). Real providers are opt-in.
EMAIL_PROVIDER=fixture
# Resend (send-only adapter; it is NOT a mailbox reader)
RESEND_API_KEY=
RESEND_FROM=

# --- n8n (optional) ---
# Outbound: the app POSTs signed events to your n8n webhook base URL.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# Inbound: n8n calls the app with this bearer token (generate a long random string).
N8N_INBOUND_TOKEN=
